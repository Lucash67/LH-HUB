# Database provider: postgres (official)
DB_PROVIDER=postgres

# Supabase Transaction Pooler — copy URI from Dashboard → Connect → Transaction pooler
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-ca-central-1.pooler.supabase.com:6543/postgres

# Auth — sessões JWT (mínimo 32 caracteres em produção)
# AUTH_SECRET=your-long-random-secret-at-least-32-chars
